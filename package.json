{
  "name": "dsh-pet",
  "version": "0.3.7-fork.2",
  "description": "吃白饭的蓝色大肥鱼，赖在 DeepSeek Harness 里不走了。平时爱玩魔方、爱吃各种零食、偶尔打个盹，闲不住就在桌面上溜达两圈，被你拖来甩去也照旧赖着；你忙起来它跟着忙前忙后，也会帮你打理余额钱包，闲下来爱碎碎念，还乐意陪你唠两句。",
  "icon": "dsh-pet/assets/logo.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "floating-widget",
    "web-ui",
    "cordis",
    "react"
  ],
  "homepage": "https://github.com/vb2250158/dsh-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-pet.git"
  },
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-pet/issues"
  },
  "type": "module",
  "main": "dsh-pet/lib/index.js",
  "bin": {
    "dsh-pet-standalone": "dsh-pet/lib/standalone.js"
  },
  "exports": {
    ".": {
      "types": "./dsh-pet/lib/types/index.d.ts",
      "default": "./dsh-pet/lib/index.js"
    },
    "./client": {
      "types": "./dsh-pet/lib/types/client/index.d.ts",
      "default": "./dsh-pet/lib/client.js"
    },
    "./src/*": "./dsh-pet/src/*",
    "./cordis.patch.yml": "./dsh-pet/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-pet/lib",
    "dsh-pet/src",
    "dsh-pet/assets/webm",
    "dsh-pet/runtime/electron-helper",
    "dsh-pet/assets/fonts",
    "dsh-pet/assets/pic",
    "dsh-pet/assets/memes",
    "dsh-pet/assets/config.jsonc",
    "dsh-pet/assets/logo.png",
    "dsh-pet/scripts/ensure-electron.mjs",
    "dsh-pet/cordis.patch.yml"
  ],
  "scripts": {
    "build": "npm --prefix dsh-pet run build",
    "test": "npm --prefix dsh-pet test",
    "typecheck": "npm --prefix dsh-pet run typecheck",
    "lint": "npm --prefix dsh-pet run lint",
    "prepack": "npm --prefix dsh-pet run prepack"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-pet/cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.2": "incompatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^5.4.2",
    "prettier": "^3.9.6",
    "rolldown": "1.0.0-beta.7",
    "tsdown": "^0.8.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "rolldown": "1.0.0-beta.7"
  }
}
